SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SCOPES=write_products,read_products,read_orders
DATABASE_URL=postgresql://postgres:password@localhost:5432/stocklog

# Optional manual override. Unset, charges are test charges on development
# stores and real charges everywhere else.
# BILLING_TEST=true

# Sentry error monitoring. Unset (the normal local case) Sentry never
# initialises and the app runs exactly as it would without it — so leave this
# blank for local dev. Set it in Render for staging/production. Errors only:
# tracesSampleRate is 0, so no performance data is sent and the free tier is
# not spent on traces. Copy the DSN from Sentry → Project → Settings → Client
# Keys (DSN); it is a public write-only key, not a secret.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
