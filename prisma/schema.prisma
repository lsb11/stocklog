// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StockMovement {
  id            String   @id @default(cuid())
  shop          String
  productId     String?
  variantId     String
  sku           String?
  productTitle  String
  quantityDelta Int
  reason        String
  orderId       String?
  // For refund_restock rows, orderId holds the Refund GID (refunds are their own
  // resource). sourceOrderId records the parent Order GID so the cancellation
  // handler can see what a refund already restocked and avoid double-reversing.
  sourceOrderId String?
  createdAt     DateTime @default(now())

  @@index([shop, variantId])
  @@index([shop, createdAt])
  @@index([shop, sourceOrderId])
}

model VariantSettings {
  id           String @id @default(cuid())
  shop         String
  variantId    String
  reorderPoint Int?

  @@unique([shop, variantId])
  @@index([shop])
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
